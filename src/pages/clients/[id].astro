---
import ClientLayout from "../../layouts/client_layout.astro";

interface Client {
  _id: string;
  name: string;
  rubro?: string;
  socialNetworks: string[];
  phone: string[];
  location: string[];
}

const { id } = Astro.params;

const response = await fetch(
  `https://virtual-cards-api-zeta.vercel.app/api/clients/${id}`
);
const client: Client = await response.json();

const social_networks: string[] = client.socialNetworks || [];
const numbers: string[] = client.phone || [];
const locations: string[] = client.location || [];
let cont = 1;
---

<ClientLayout title={client.name} cliente={client}>
  <div class="social-networks">
    {
      numbers.length === 1 ? (
        <a
          class="button"
          href={`https://wa.me/${numbers[0]}?text=Hola ${client.name} quiero contactarte`}
          target="_blank"
        >
          <img src="/icons/whatsapp.webp" alt="whatsapp" />
          WHATSAPP
        </a>
      ) : (
        numbers.map((number: string) => {
          let linkWhapp = `https://wa.me/${number}?text=Hola ${client.name} quiero contactarte`;
          return (
            <a class="button" href={linkWhapp} target="_blank">
              <img src="/icons/whatsapp.webp" alt="whatsapp" />
              WHATSAPP {cont++}
            </a>
          );
        })
      )
    }
    {
      social_networks.map((social_network: string) => {
        let net = social_network.split(".")[1] || "social";
        let source = `/icons/${net}.webp`;
        return (
          <a class="button" href={social_network} target="_blank">
            <img src={source} alt={net} />
            {net.toUpperCase()}
          </a>
        );
      })
    }
    {
      locations.length === 1 ? (
        <a class="button" href={locations[0]} target="_blank">
          <img src="/icons/map.webp" alt="location" />
          UBICACIÓN
        </a>
      ) : (
        locations.map((location: string) => {
          return (
            <a class="button" href={location} target="_blank">
              <img src="/icons/map.webp" alt="location" />
              UBICACIÓN
            </a>
          );
        })
      )
    }
  </div>
</ClientLayout>

<style>
  .social-networks {
    display: block;
    background-color: hsla(48, 100%, 92%, 0.1);
    width: 300px;
    margin: 0;
    padding: 20px;
  }

  .button {
    display: flex;
    background-color: #222;
    color: white;
    text-decoration: none;
    padding: 10px;
    margin: 10px 0;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .button img {
    width: 25px;
    height: 25px;
    margin-right: 20px;
  }
</style>
