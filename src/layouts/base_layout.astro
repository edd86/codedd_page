---
import "../styles/global.css";
import { profileData } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profileData.name} | ${profileData.title} & Portfolio`,
  description = profileData.bio,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Sora & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-[#0a0a0a] text-[#e5e2e1] min-h-screen relative font-sans selection:bg-primary selection:text-white"
  >
    <!-- Background Ambient Glow Orbs -->
    <div
      class="fixed top-[-10%] left-[-10%] w-[500px] h-[500px] rounded-full bg-primary/10 blur-[120px] pointer-events-none z-0"
    >
    </div>
    <div
      class="fixed bottom-[-10%] right-[-10%] w-[500px] h-[500px] rounded-full bg-secondary/10 blur-[120px] pointer-events-none z-0"
    >
    </div>

    <!-- Header / Navbar -->
    <header
      class="sticky top-4 z-50 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 transition-all"
    >
      <nav
        class="bg-[#131313]/80 backdrop-blur-md border border-white/10 rounded-2xl px-6 py-3.5 flex items-center justify-between shadow-2xl"
      >
        <!-- Logo Brand -->
        <a href="#hero" class="flex items-center gap-3 group">
          <div
            class="w-10 h-10 rounded-xl bg-gradient-to-tr from-primary to-secondary flex items-center justify-center font-display font-extrabold text-lg text-white shadow-lg group-hover:scale-105 transition-transform"
          >
            ED
          </div>
          <div class="flex flex-col">
            <span
              class="font-display font-bold text-white group-hover:text-primary transition-colors text-base tracking-tight"
              >CodEDD</span
            >
            <span class="text-xs text-neutral-muted hidden sm:inline"
              >Software Developer</span
            >
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <div class="hidden md:flex items-center gap-8 text-sm font-medium">
          <a
            href="#hero"
            class="text-neutral-muted hover:text-white transition-colors"
            >Inicio</a
          >
          <a
            href="#skills"
            class="text-neutral-muted hover:text-white transition-colors"
            >Habilidades</a
          >
          <a
            href="#projects"
            class="text-neutral-muted hover:text-white transition-colors"
            >Proyectos</a
          >
          <a
            href="#education"
            class="text-neutral-muted hover:text-white transition-colors"
            >Formación</a
          >
          <a
            href="#contact"
            class="text-neutral-muted hover:text-white transition-colors"
            >Contacto</a
          >
        </div>

        <!-- Quick CTA Button -->
        <a
          href={profileData.contact.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-primary to-secondary text-white font-medium text-xs sm:text-sm shadow-glow-primary hover:opacity-90 hover:scale-[1.02] active:scale-[0.98] transition-all"
        >
          <span>Contactar por WhatsApp</span>
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="relative z-10 border-t border-white/10 bg-[#0e0e0e]/80 backdrop-blur-md mt-20 py-10"
    >
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left"
      >
        <div>
          <p class="font-display font-bold text-white text-lg">
            Edward Cristóbal Díaz Valda
          </p>
          <p class="text-sm text-neutral-muted mt-1">
            📍 Sucre, Bolivia — Software Developer
          </p>
        </div>

        <div class="flex items-center gap-6 text-sm text-neutral-muted">
          <a
            href={profileData.contact.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-primary transition-colors">GitHub</a
          >
          <a
            href={profileData.contact.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-secondary transition-colors">LinkedIn</a
          >
          <a
            href={`mailto:${profileData.contact.email}`}
            class="hover:text-primary transition-colors">Email</a
          >
        </div>

        <p class="text-xs text-neutral-muted">
          &copy; {new Date().getFullYear()} CodEDD. Diseñado con Lumina Grid, Astro
          & Tailwind CSS.
        </p>
      </div>
    </footer>
  </body>
</html>
