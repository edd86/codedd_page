---
import { projects } from "../data/projects";
import ProjectModal from "./ProjectModal.astro";
---

<section id="projects" class="w-full my-12">
  <!-- Section Title & Filter Tabs -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
    <div>
      <span class="text-xs font-mono font-semibold tracking-widest text-secondary uppercase">Portafolio &amp; Experiencia</span>
      <h2 class="text-2xl sm:text-4xl font-display font-extrabold text-white mt-1">Proyectos Destacados</h2>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2" id="project-filters">
      <button
        data-filter="all"
        class="filter-btn active-filter px-4 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-primary to-secondary text-white shadow-glow-primary transition-all"
      >
        Todos ({projects.length})
      </button>
      <button
        data-filter="mobile"
        class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 text-neutral-variant border border-white/10 transition-colors"
      >
        Móvil (Flutter)
      </button>
      <button
        data-filter="backend"
        class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 text-neutral-variant border border-white/10 transition-colors"
      >
        Backend &amp; APIs
      </button>
      <button
        data-filter="web"
        class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 text-neutral-variant border border-white/10 transition-colors"
      >
        Web &amp; NFC
      </button>
      <button
        data-filter="instruction"
        class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 text-neutral-variant border border-white/10 transition-colors"
      >
        Docencia &amp; INE
      </button>
    </div>
  </div>

  <!-- Bento Grid Projects Container -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-4" id="projects-grid">
    {projects.map((project) => {
      const isFeatured = project.featured;
      const colSpanClass = isFeatured ? 'lg:col-span-6' : 'lg:col-span-4';
      const mainImg = project.images && project.images.length > 0 ? project.images[0].url : '/images/projects/project_api_1.svg';

      return (
        <div
          class={`project-item bento-card p-6 flex flex-col justify-between group ${colSpanClass}`}
          data-category={project.category}
        >
          <!-- Top image thumbnail with hover zoom -->
          <div
            class="relative w-full h-48 sm:h-56 rounded-xl overflow-hidden mb-5 bg-[#0a0a0a] border border-white/10 group-hover:border-primary/50 transition-colors cursor-pointer"
            data-open-modal
            data-project-id={project.id}
          >
            <img
              src={mainImg}
              alt={project.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#131313] via-transparent to-transparent opacity-80"></div>
            
            <div class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-[#0a0a0a]/80 backdrop-blur-md border border-white/10 text-[11px] font-mono text-secondary">
              {project.category.toUpperCase()}
            </div>

            {project.images.length > 1 && (
              <div class="absolute top-3 right-3 px-2.5 py-1 rounded-md bg-primary/80 backdrop-blur-md text-[11px] font-mono font-bold text-white shadow-lg">
                🖼️ {project.images.length} Fotos
              </div>
            )}
          </div>

          <!-- Project Details -->
          <div>
            <div class="flex items-center justify-between text-xs text-neutral-muted mb-1 font-mono">
              <span>{project.period}</span>
              <span>{project.companyOrClient || project.location}</span>
            </div>

            <h3
              class="font-display font-bold text-lg sm:text-xl text-white group-hover:text-primary transition-colors cursor-pointer"
              data-open-modal
              data-project-id={project.id}
            >
              {project.title}
            </h3>

            <p class="text-xs text-secondary font-medium mt-0.5 mb-2">
              {project.role}
            </p>

            <p class="text-neutral-variant text-xs sm:text-sm line-clamp-2 mb-4">
              {project.description}
            </p>

            <!-- Tech Tag Chips -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              {project.tags.slice(0, 4).map((tag) => (
                <span class="px-2 py-0.5 rounded-md bg-white/5 border border-white/10 text-[11px] font-mono text-neutral-variant">
                  {tag}
                </span>
              ))}
              {project.tags.length > 4 && (
                <span class="px-2 py-0.5 rounded-md bg-white/5 border border-white/10 text-[11px] font-mono text-neutral-muted">
                  +{project.tags.length - 4}
                </span>
              )}
            </div>
          </div>

          <!-- Card Actions -->
          <div class="pt-4 border-t border-white/10 flex items-center justify-between">
            <button
              data-open-modal
              data-project-id={project.id}
              class="text-xs font-semibold text-primary hover:text-white inline-flex items-center gap-1 transition-colors"
            >
              <span>Ver Galería &amp; Detalles</span>
              <span>&rarr;</span>
            </button>

            {project.repository && (
              <a
                href={project.repository}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-mono text-neutral-muted hover:text-secondary inline-flex items-center gap-1 transition-colors"
              >
                <span>GitHub ↗</span>
              </a>
            )}
          </div>
        </div>
      );
    })}
  </div>

  <!-- Include Dialog Modal component -->
  <ProjectModal />
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const filterBtns = document.querySelectorAll("#project-filters .filter-btn");
    const projectCards = document.querySelectorAll("#projects-grid .project-item");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter");

        // Update active filter style
        filterBtns.forEach((b) => {
          b.classList.remove("active-filter", "bg-gradient-to-r", "from-primary", "to-secondary", "text-white", "shadow-glow-primary");
          b.classList.add("bg-white/5", "text-neutral-variant");
        });

        btn.classList.remove("bg-white/5", "text-neutral-variant");
        btn.classList.add("active-filter", "bg-gradient-to-r", "from-primary", "to-secondary", "text-white", "shadow-glow-primary");

        // Filter cards
        projectCards.forEach((card) => {
          const category = card.getAttribute("data-category");

          if (filter === "all" || category === filter) {
            (card as HTMLElement).style.display = "flex";
          } else {
            (card as HTMLElement).style.display = "none";
          }
        });
      });
    });
  });
</script>
