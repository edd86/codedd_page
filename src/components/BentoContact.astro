---
import { profileData } from "../data/profile";
---

<section id="contact" class="w-full my-12">
  <div class="mb-6">
    <span class="text-xs font-mono font-semibold tracking-widest text-secondary uppercase">Contacto &amp; Colaboración</span>
    <h2 class="text-2xl sm:text-4xl font-display font-extrabold text-white mt-1">Hablemos de tu Próximo Proyecto</h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
    <!-- Contact Details & Quick Copy (5 cols) -->
    <div class="lg:col-span-5 bento-card p-6 sm:p-8 flex flex-col justify-between">
      <div>
        <h3 class="font-display font-bold text-white text-xl mb-2">Información Directa</h3>
        <p class="text-neutral-variant text-sm mb-6">
          ¿Tienes una idea de app móvil, plataforma web o proyecto backend? Escríbeme y lo hacemos realidad.
        </p>

        <div class="space-y-4">
          <!-- WhatsApp Button -->
          <a
            href={profileData.contact.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full p-4 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 font-semibold text-sm flex items-center justify-between transition-colors"
          >
            <div class="flex items-center gap-3">
              <span class="text-lg">💬</span>
              <span>WhatsApp Directo ({profileData.contact.phone})</span>
            </div>
            <span>&rarr;</span>
          </a>

          <!-- Email Quick Copy -->
          <div class="p-4 rounded-xl bg-white/5 border border-white/10 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="text-lg">✉️</span>
              <div>
                <span class="block text-xs text-neutral-muted">Email</span>
                <span id="email-text" class="text-sm font-mono text-white">{profileData.contact.email}</span>
              </div>
            </div>
            <button
              id="copy-email-btn"
              class="px-3 py-1.5 rounded-lg bg-primary/20 hover:bg-primary/30 text-primary text-xs font-semibold transition-colors"
            >
              Copiar
            </button>
          </div>

          <!-- Location Badge -->
          <div class="p-4 rounded-xl bg-white/5 border border-white/10 flex items-center gap-3">
            <span class="text-lg">📍</span>
            <div>
              <span class="block text-xs text-neutral-muted">Ubicación Principal</span>
              <span class="text-sm font-semibold text-white">{profileData.location}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Social Media Badges -->
      <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-between">
        <a
          href={profileData.contact.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono text-neutral-muted hover:text-white transition-colors"
        >
          GitHub: <span class="text-primary font-bold">@edd86</span>
        </a>
        <a
          href={profileData.contact.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono text-neutral-muted hover:text-white transition-colors"
        >
          LinkedIn ↗
        </a>
      </div>
    </div>

    <!-- Contact Form (7 cols) -->
    <div class="lg:col-span-7 bento-card p-6 sm:p-8">
      <h3 class="font-display font-bold text-white text-xl mb-4">Enviar Mensaje</h3>

      <form id="contact-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-xs font-mono text-neutral-muted mb-1">Tu Nombre</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Ej. Juan Pérez"
              class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-neutral-muted text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-mono text-neutral-muted mb-1">Correo Electrónico</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="tu@email.com"
              class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-neutral-muted text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="block text-xs font-mono text-neutral-muted mb-1">Asunto / Tipo de Proyecto</label>
          <input
            type="text"
            id="subject"
            name="subject"
            required
            placeholder="Ej. Desarrollo App Flutter / API Node.js"
            class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-neutral-muted text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
          />
        </div>

        <div>
          <label for="message" class="block text-xs font-mono text-neutral-muted mb-1">Detalles del Mensaje</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="Cuéntame sobre las funcionalidades y tiempos estimados..."
            class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-neutral-muted text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all resize-none"
          ></textarea>
        </div>

        <div class="flex items-center justify-between pt-2">
          <span id="form-status" class="text-xs font-mono text-secondary hidden">
            ✓ Mensaje preparado (redireccionando a tu correo...)
          </span>

          <button
            type="submit"
            class="ml-auto px-6 py-3 rounded-xl bg-gradient-to-r from-primary to-secondary text-white font-semibold text-sm shadow-glow-primary hover:opacity-95 transition-all"
          >
            Enviar Mensaje 🚀
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { profileData } from "../data/profile";

  document.addEventListener("DOMContentLoaded", () => {
    // Copy email button
    const copyBtn = document.getElementById("copy-email-btn");
    copyBtn?.addEventListener("click", () => {
      navigator.clipboard.writeText(profileData.contact.email).then(() => {
        copyBtn.textContent = "¡Copiado!";
        setTimeout(() => {
          copyBtn.textContent = "Copiar";
        }, 2000);
      });
    });

    // Form submission via mailto link
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const formStatus = document.getElementById("form-status");

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const name = (document.getElementById("name") as HTMLInputElement).value;
      const email = (document.getElementById("email") as HTMLInputElement).value;
      const subject = (document.getElementById("subject") as HTMLInputElement).value;
      const message = (document.getElementById("message") as HTMLTextAreaElement).value;

      const mailtoUrl = `mailto:${profileData.contact.email}?subject=${encodeURIComponent(
        `[Contacto Portafolio] ${subject}`
      )}&body=${encodeURIComponent(
        `Nombre: ${name}\nEmail: ${email}\n\nMensaje:\n${message}`
      )}`;

      if (formStatus) {
        formStatus.classList.remove("hidden");
      }

      setTimeout(() => {
        window.location.href = mailtoUrl;
      }, 500);
    });
  });
</script>
