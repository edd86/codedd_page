---
import { profileData } from "../data/profile";
---

<section id="skills" class="w-full my-8">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-6">
    <div>
      <span class="text-xs font-mono font-semibold tracking-widest text-primary uppercase">Habilidades &amp; Stack</span>
      <h2 class="text-2xl sm:text-3xl font-display font-extrabold text-white mt-1">Tecnologías Dominios &amp; Herramientas</h2>
    </div>
    <p class="text-sm text-neutral-muted max-w-md mt-2 md:mt-0">
      Especializado en arquitectura móvil multiplataforma, desarrollo backend escalable y desarrollo web moderno.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {profileData.skills.map((skillGroup, idx) => {
      const isFirst = idx === 0;
      const isSecond = idx === 1;
      return (
        <div class={`bento-card p-6 flex flex-col justify-between group ${isFirst || isSecond ? 'lg:col-span-1' : ''}`}>
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-display font-bold text-lg text-white group-hover:text-primary transition-colors">
                {skillGroup.category}
              </h3>
              <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-xs font-mono text-secondary">
                0{idx + 1}
              </span>
            </div>

            <div class="flex flex-wrap gap-2">
              {skillGroup.items.map((skill) => (
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-neutral-variant text-xs font-medium border border-white/10 hover:border-primary/40 transition-all hover:scale-105">
                  <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                  <span>{skill.name}</span>
                  {skill.level && (
                    <span class="text-[10px] text-primary bg-primary/10 px-1.5 py-0.5 rounded font-semibold ml-1">
                      {skill.level}
                    </span>
                  )}
                </span>
              ))}
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs text-neutral-muted">
            <span>Tecnologías clave</span>
            <span class="text-secondary font-mono">✦ Lumina Grid</span>
          </div>
        </div>
      );
    })}
  </div>
</section>
